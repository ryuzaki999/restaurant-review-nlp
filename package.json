{
  "name": "restaurant-review-nlp",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant Review Platform with automatic NLP sentiment analysis (Node.js + Express + SQLite)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
